# Public HTTPS host served by Caddy.
CLOUDROP_DOMAIN=drop.example.com

# Required Django secrets. Generate long random values for both.
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
CLOUDROP_ACCESS_PASSWORD=replace-with-the-deployment-access-password
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=drop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://drop.example.com
DJANGO_SECURE_COOKIES=true
CLOUDROP_TRUSTED_PROXY_COUNT=1
UVICORN_WORKERS=2

# Existing PostgreSQL instance: use a dedicated database and role.
DATABASE_URL=postgresql://cloudrop:replace-with-url-encoded-password@host.docker.internal:5432/cloudrop

# Existing Redis instance: choose a logical database not used by another project.
REDIS_URL=redis://:replace-with-url-encoded-password@host.docker.internal:6379/5
CLOUDROP_REDIS_PREFIX=cloudrop

# Coturn and Django must share the same secret.
CLOUDROP_TURN_SECRET=replace-with-a-long-random-turn-secret
CLOUDROP_TURN_REALM=drop.example.com
CLOUDROP_TURN_EXTERNAL_IP=203.0.113.10
CLOUDROP_TURN_URLS=stun:drop.example.com:3478,turn:drop.example.com:3478?transport=udp,turn:drop.example.com:3478?transport=tcp
CLOUDROP_TURN_CREDENTIAL_TTL=3600

